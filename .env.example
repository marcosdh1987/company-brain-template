# =============================================================================
# OpenCode runtime configuration for the brain (copy to .env and edit).
#
# opencode.json reads these via {env:...}. `make opencode` and `make opencode-doctor`
# load ./.env if present, otherwise ../ml-python-base/.env — so a single .env kept in
# the harness repo serves both. Same variable names and provider aliases as
# ml-python-base/.env.example; the long tuning notes live there and in its
# docs/local-model-mac-setup.md. Keep comments on their OWN lines. .env is gitignored.
# =============================================================================

# --- Profile A: active models via the LiteLLM gateway (format: provider/model-id) --
# The id must EXACTLY match what your server serves:
#   make opencode-doctor        (reachability + which .env was loaded)
#   opencode models             (every provider/model opencode sees)
# `gateway/*` aliases resolve only against the LiteLLM aliases YOUR gateway defines
# (ml-python-base/gateway/config.yaml, mirrored in opencode.json provider.gateway).
#
# Main tier — `build` agent (EXECUTION). Self-hosted, capped at the gateway.
OPENCODE_MODEL=gateway/lmstudio-qwen3.6-35b-build
# Lightweight tier (titles, quick tasks):
OPENCODE_SMALL_MODEL=gateway/ollama-qwen3-8b
# PLAN tier — `plan` agent (Tab to switch). Strong cloud for the small backlog only.
OPENCODE_MODEL_PLAN=gateway/gpt-5.5
# Alternatives:
#   Cheaper plan:                     OPENCODE_MODEL_PLAN=gateway/gpt-5
#   NVIDIA NIM via ai-gateway:        OPENCODE_MODEL_PLAN=gateway/nim-nemotron-super-120b
#   All-local plan (no cloud spend):  OPENCODE_MODEL_PLAN=gateway/lmstudio-qwen3.6-35b-build
#   No gateway (direct to servers):   OPENCODE_MODEL=lmstudio/qwen/qwen3-coder-30b
#                                     OPENCODE_MODEL_PLAN=opencode/nemotron-3-ultra-free

# --- AI Gateway (LiteLLM) — used by the `gateway/*` models above -------------
# baseURL must end in /v1. GATEWAY_TOKEN = your LITELLM_MASTER_KEY (or a virtual key).
GATEWAY_BASE_URL=http://localhost:4000/v1
GATEWAY_TOKEN=sk-local-change-me

# --- Self-hosted endpoints (direct, no gateway) — used by ollama/* lmstudio/* -
# Also drive `make opencode-doctor` reachability checks.
OLLAMA_BASE_URL=http://localhost:11434/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# --- Profile B: no gateway, direct to LM Studio (works with nothing else running) -
# Use this when there is no LiteLLM gateway and no Ollama. Start LM Studio (the app
# must be open — `lms server start` cannot wake the daemon on its own), then read the
# EXACT served ids and paste them below:
#   lms ls
#   curl http://localhost:1234/v1/models | python3 -m json.tool
# Do not guess an id from the folder name: the API id and the folder name differ.
#   OPENCODE_MODEL=lmstudio/<served-id>
#   OPENCODE_MODEL_PLAN=lmstudio/<served-id>     # same model for plan and build
#   OPENCODE_SMALL_MODEL=lmstudio/<smaller-served-id>
# Add each served id under provider.lmstudio.models in opencode.json so it shows in
# the picker. Raise Context Length to >= 16384 in the model load settings, or a small
# model loses the task — see ml-python-base/docs/local-model-mac-setup.md.

# --- Profile C: no local server at all (OpenCode Zen free models) -------------
# Run `opencode auth login` once, pick OpenCode Zen, then:
#   OPENCODE_MODEL=opencode/nemotron-3-ultra-free
#   OPENCODE_MODEL_PLAN=opencode/nemotron-3-ultra-free

# --- Cloud providers ---------------------------------------------------------
# OpenCode Zen *-free models are built in: run `opencode auth login` once, no key here.
# NVIDIA NIM is OPTIONAL for the direct nvidia/ provider (free key at build.nvidia.com).
NVIDIA_API_KEY=
